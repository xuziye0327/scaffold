{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 101,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "proseWrap": "preserve",
  "sortImports": {
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "sortPackageJson": true
}
